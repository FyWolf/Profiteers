<%- include('../../partials/header') %>

<div class="container">
    <header>
        <h1>📦 Store Items</h1>
        <div class="subtitle">Manage store inventory items</div>
    </header>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="section">
        <div class="top-row">
            <h2>Add Item</h2>
            <a href="/admin/store/import" class="btn">📤 Bulk Import</a>
        </div>
        <form method="POST" class="form-wrap" style="max-width: 700px;">
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label>Category</label>
                    <select name="category_id" required>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label>Type</label>
                    <select name="item_type" required>
                        <% itemTypes.forEach(t => { %>
                            <option value="<%= t %>"><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label>Class Name (Arma 3)</label>
                    <input type="text" name="class_name" placeholder="e.g. arifle_MX_F" required>
                </div>
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label>Display Name</label>
                    <input type="text" name="display_name" placeholder="e.g. MX 6.5mm" required>
                </div>
            </div>
            <div class="field">
                <label>Description</label>
                <textarea name="description" rows="2" placeholder="Optional description"></textarea>
            </div>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label>Base Price (¢)</label>
                    <input type="number" name="base_price" value="100" min="0" required>
                </div>
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label>Stock (-1 = unlimited)</label>
                    <input type="number" name="stock" value="-1">
                </div>
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label>Max Per Player (-1 = unlimited)</label>
                    <input type="number" name="max_per_player" value="-1">
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Add Item</button>
            </div>
        </form>
    </div>

    <div class="section">
        <div class="top-row">
            <h2>All Items <span style="font-weight:400; color:var(--khaki); font-size:0.9rem;">(<%= total.toLocaleString() %>)</span></h2>
            <form method="GET" action="/admin/store/items" style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search name or class..." style="padding:0.4rem 0.6rem; background:rgba(0,0,0,0.4); border:1px solid rgba(107,142,35,0.5); border-radius:4px; color:var(--sand); font-size:0.85rem;">
                <select name="category" onchange="this.form.submit()" style="padding:0.4rem 0.6rem; background:rgba(0,0,0,0.4); border:1px solid rgba(107,142,35,0.5); border-radius:4px; color:var(--sand); font-size:0.85rem;">
                    <option value="">All Categories</option>
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat.id %>" <%= filters.category === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                    <% }) %>
                </select>
                <select name="type" onchange="this.form.submit()" style="padding:0.4rem 0.6rem; background:rgba(0,0,0,0.4); border:1px solid rgba(107,142,35,0.5); border-radius:4px; color:var(--sand); font-size:0.85rem;">
                    <option value="">All Types</option>
                    <% itemTypes.forEach(t => { %>
                        <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
                    <% }) %>
                </select>
                <button type="submit" class="btn">Search</button>
                <% if (filters.q || filters.type || filters.category !== '') { %><a href="/admin/store/items" class="btn btn-danger">Clear</a><% } %>
            </form>
        </div>
        <% if (total === 0) { %>
            <p class="empty-state">No items match your filters.</p>
        <% } else { %>
        <div class="table-responsive">
            <table class="admin-table" id="itemsTable">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Class Name</th>
                        <th>Display Name</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% items.forEach(item => { %>
                        <tr id="item-row-<%= item.id %>" data-category="<%= item.category_name.toLowerCase() %>" data-type="<%= item.item_type %>">
                            <td class="item-img-cell">
                                <% if (item.image_url) { %>
                                    <img src="<%= item.image_url %>" alt="<%= item.class_name %>" class="item-thumb">
                                <% } else { %>
                                    <span class="no-img">🖼️</span>
                                <% } %>
                            </td>
                            <td><code><%= item.class_name %></code></td>
                            <td><%= item.display_name %></td>
                            <td><%= item.category_name %></td>
                            <td><span class="type-badge type-<%= item.item_type %>"><%= item.item_type %></span></td>
                            <td><%= item.base_price.toLocaleString() %>¢</td>
                            <td><%= item.stock === -1 ? '∞' : item.stock %></td>
                            <td><%= item.is_active ? '✅' : '❌' %></td>
                            <td>
                                <button class="act act-edit" onclick="toggleEdit(<%= item.id %>)">✏️</button>
                                <a class="act" href="/admin/store/items/<%= item.id %>/images" title="Manage images">🖼️</a>
                                <form method="POST" action="/admin/store/items/<%= item.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this item?')">
                                    <button type="submit" class="act act-del">🗑️</button>
                                </form>
                            </td>
                        </tr>
                        <tr id="item-edit-<%= item.id %>" class="edit-row" style="display:none">
                            <td colspan="9">
                                <form method="POST" action="/admin/store/items/<%= item.id %>/edit" class="inline-edit-form">
                                    <div class="edit-grid">
                                        <div class="edit-field">
                                            <label>Category</label>
                                            <select name="category_id">
                                                <% categories.forEach(cat => { %>
                                                    <option value="<%= cat.id %>" <%= item.category_id === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div class="edit-field">
                                            <label>Type</label>
                                            <select name="item_type">
                                                <% itemTypes.forEach(t => { %>
                                                    <option value="<%= t %>" <%= item.item_type === t ? 'selected' : '' %>><%= t %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div class="edit-field">
                                            <label>Class Name</label>
                                            <input type="text" name="class_name" value="<%= item.class_name %>" required>
                                        </div>
                                        <div class="edit-field">
                                            <label>Display Name</label>
                                            <input type="text" name="display_name" value="<%= item.display_name %>" required>
                                        </div>
                                        <div class="edit-field" style="flex:2">
                                            <label>Description</label>
                                            <input type="text" name="description" value="<%= item.description || '' %>">
                                        </div>
                                        <div class="edit-field">
                                            <label>Price (¢)</label>
                                            <input type="number" name="base_price" value="<%= item.base_price %>" min="0" required>
                                        </div>
                                        <div class="edit-field">
                                            <label>Stock</label>
                                            <input type="number" name="stock" value="<%= item.stock %>">
                                        </div>
                                        <div class="edit-field">
                                            <label>Max/Player</label>
                                            <input type="number" name="max_per_player" value="<%= item.max_per_player %>">
                                        </div>
                                        <div class="edit-field">
                                            <label>Active</label>
                                            <select name="is_active">
                                                <option value="1" <%= item.is_active ? 'selected' : '' %>>Yes</option>
                                                <option value="0" <%= !item.is_active ? 'selected' : '' %>>No</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-actions">
                                        <button type="submit" class="btn">💾 Save</button>
                                        <button type="button" class="btn btn-danger" onclick="toggleEdit(<%= item.id %>)">Cancel</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="admin-results-info" style="color:var(--khaki); font-size:0.85rem; margin-top:0.75rem;">
            Showing <strong><%= from.toLocaleString() %>–<%= to.toLocaleString() %></strong> of <strong><%= total.toLocaleString() %></strong>
        </div>

        <% if (totalPages > 1) {
            const pStart = Math.max(1, page - 2);
            const pEnd = Math.min(totalPages, page + 2);
            const sep = baseQs ? '&' : '';
        %>
            <nav class="pagination" style="margin-top:1rem;">
                <% if (page > 1) { %><a class="page-btn" href="/admin/store/items?<%= baseQs %><%= sep %>page=<%= page - 1 %>">‹ Prev</a><% } %>
                <% if (pStart > 1) { %>
                    <a class="page-btn" href="/admin/store/items?<%= baseQs %><%= sep %>page=1">1</a>
                    <% if (pStart > 2) { %><span class="page-dots">…</span><% } %>
                <% } %>
                <% for (let n = pStart; n <= pEnd; n++) { %>
                    <% if (n === page) { %><span class="page-btn current"><%= n %></span>
                    <% } else { %><a class="page-btn" href="/admin/store/items?<%= baseQs %><%= sep %>page=<%= n %>"><%= n %></a><% } %>
                <% } %>
                <% if (pEnd < totalPages) { %>
                    <% if (pEnd < totalPages - 1) { %><span class="page-dots">…</span><% } %>
                    <a class="page-btn" href="/admin/store/items?<%= baseQs %><%= sep %>page=<%= totalPages %>"><%= totalPages %></a>
                <% } %>
                <% if (page < totalPages) { %><a class="page-btn" href="/admin/store/items?<%= baseQs %><%= sep %>page=<%= page + 1 %>">Next ›</a><% } %>
            </nav>
        <% } %>
        <% } %>
    </div>
</div>

<script>
function toggleEdit(id) {
    const row = document.getElementById('item-edit-' + id);
    row.style.display = row.style.display === 'none' ? 'table-row' : 'none';
}
</script>

<%- include('../../partials/footer') %>
