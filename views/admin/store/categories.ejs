<%- include('../../partials/header') %>

<div class="container">
    <header>
        <h1><i class="fas fa-folder"></i> Store Categories</h1>
        <div class="subtitle">Manage item categories</div>
    </header>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="section">
        <div class="top-row">
            <h2>Add Category</h2>
        </div>
        <form method="POST" class="form-wrap">
            <div class="field">
                <label>Name</label>
                <input type="text" name="name" placeholder="Category Name" required>
            </div>
            <div class="field">
                <label>Slug</label>
                <input type="text" name="slug" placeholder="slug-name" required>
            </div>
            <div class="field">
                <label>Icon</label>
                <input type="text" name="icon" placeholder="fontawesome icon name (e.g. crosshairs)" value="box">
            </div>
            <div class="field">
                <label>Display Order</label>
                <input type="number" name="display_order" placeholder="Order" value="0">
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Add Category</button>
            </div>
        </form>
    </div>

    <div class="section">
        <div class="top-row">
            <h2>All Categories</h2>
            <input type="text" id="catSearch" placeholder="Search categories..." style="padding:0.4rem 0.6rem; background:rgba(0,0,0,0.4); border:1px solid rgba(107,142,35,0.5); border-radius:4px; color:var(--sand); font-size:0.85rem;">
        </div>
        <div class="table-responsive">
            <table class="admin-table" id="categoriesTable">
                <thead>
                    <tr>
                        <th>Icon</th>
                        <th>Name</th>
                        <th>Slug</th>
                        <th>Order</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach(cat => { %>
                        <tr>
                            <td><i class="fas fa-<%= cat.icon %>"></i></td>
                            <td><%= cat.name %></td>
                            <td><code><%= cat.slug %></code></td>
                            <td><%= cat.display_order %></td>
                            <td>
                                <form method="POST" action="/admin/store/categories/<%= cat.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this category and all its items?')">
                                    <button type="submit" class="act act-del"><i class="fas fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.getElementById('catSearch').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll('#categoriesTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
});
</script>

<%- include('../../partials/footer') %>

