<%- include('../../partials/header') %>

<div class="container">
    <h1><i class="fas fa-folder"></i> Store Categories</h1>
    <a href="/admin/store" class="back-link">&larr; Back to Store Admin</a>

    <% if (typeof req !== 'undefined' && req.query && req.query.error) { %><div class="alert alert-error"><%= req.query.error %></div><% } %>

    <div class="admin-card">
        <h2>Add Category</h2>
        <form method="POST" class="inline-form">
            <input type="text" name="name" placeholder="Category Name" required>
            <input type="text" name="slug" placeholder="slug-name" required>
            <input type="text" name="icon" placeholder="fontawesome icon name (e.g. crosshairs)" value="box">
            <input type="number" name="display_order" placeholder="Order" value="0">
            <button type="submit" class="btn btn-primary">Add</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Icon</th>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Order</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% categories.forEach(cat => { %>
                    <tr>
                        <td><i class="fas fa-<%= cat.icon %>"></i></td>
                        <td><%= cat.name %></td>
                        <td><code><%= cat.slug %></code></td>
                        <td><%= cat.display_order %></td>
                        <td>
                            <form method="POST" action="/admin/store/categories/<%= cat.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this category and all its items?')">
                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<style>
.admin-card {
    background: var(--card-bg, #1e1e2e);
    border: 1px solid var(--border-color, #333);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
}
.inline-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: flex-end;
}
.inline-form input {
    padding: 0.5rem;
    background: #2a2a3a;
    border: 1px solid #444;
    border-radius: 4px;
    color: #e0e0e0;
}
.btn-primary { background: #8b6914; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; }
.btn-danger { background: #c62828; color: #fff; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer; }
.btn-sm { font-size: 0.85rem; }
.back-link { color: var(--text-secondary, #999); text-decoration: none; display: inline-block; margin-bottom: 1rem; }
.back-link:hover { color: #ffd700; }
.alert-error { background: #c62828; color: #fff; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; }
code { background: #2a2a3a; padding: 2px 6px; border-radius: 3px; font-size: 0.85rem; }
</style>

<%- include('../../partials/footer') %>
