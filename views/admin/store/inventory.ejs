<%- include('../../partials/header') %>

<div class="container">
    <h1><i class="fas fa-warehouse"></i> Inventory Management</h1>
    <a href="/admin/store" class="back-link">&larr; Back to Store Admin</a>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <!-- Player Selector -->
    <div class="admin-card">
        <h2>Select Player</h2>
        <form method="GET" action="/admin/store/inventory" class="inline-form">
            <div class="player-select-wrapper">
                <input type="text" class="player-search" placeholder="Search player..." oninput="filterPlayers(this)">
                <select name="user_id" required size="5">
                    <option value="" disabled <%= !selectedPlayer ? 'selected' : '' %>>— Select Player —</option>
                    <% players.forEach(p => { %>
                        <option value="<%= p.id %>" <%= selectedPlayer && selectedPlayer.id === p.id ? 'selected' : '' %>
                            data-name="<%= (p.discord_global_name || p.discord_username).toLowerCase() %>">
                            <%= p.discord_global_name || p.discord_username %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> View Inventory</button>
        </form>
    </div>

    <% if (selectedPlayer) { %>
        <!-- Grant Item -->
        <div class="admin-card">
            <h2><i class="fas fa-gift"></i> Grant Item to <%= selectedPlayer.discord_global_name || selectedPlayer.discord_username %></h2>
            <form method="POST" action="/admin/store/inventory/grant" class="inline-form">
                <input type="hidden" name="user_id" value="<%= selectedPlayer.id %>">
                <div class="form-group">
                    <label>Item</label>
                    <select name="item_id" required>
                        <option value="" disabled selected>— Select Item —</option>
                        <% items.forEach(item => { %>
                            <option value="<%= item.id %>"><%= item.display_name %> (<%= item.class_name %>) — <%= item.category_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Quantity</label>
                    <input type="number" name="quantity" value="1" min="1" required>
                </div>
                <button type="submit" class="btn btn-success"><i class="fas fa-plus"></i> Grant</button>
            </form>
        </div>

        <!-- Current Inventory -->
        <div class="admin-card">
            <h2><i class="fas fa-boxes"></i> <%= selectedPlayer.discord_global_name || selectedPlayer.discord_username %>'s Inventory</h2>
            <% if (playerInventory.length === 0) { %>
                <p class="empty-state">This player has no items in their inventory.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Class Name</th>
                                <th>Type</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Source</th>
                                <th>Acquired</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% playerInventory.forEach(inv => { %>
                                <tr>
                                    <td><strong><%= inv.display_name %></strong></td>
                                    <td><code><%= inv.class_name %></code></td>
                                    <td><span class="badge badge-<%= inv.item_type %>"><%= inv.item_type %></span></td>
                                    <td><%= inv.category_name %></td>
                                    <td><strong><%= inv.quantity %></strong></td>
                                    <td><span class="badge badge-<%= inv.source %>"><%= inv.source %></span></td>
                                    <td><%= new Date(inv.acquired_at).toLocaleDateString() %></td>
                                    <td>
                                        <form method="POST" action="/admin/store/inventory/remove" class="inline-form" style="display:flex; gap:0.25rem; align-items:center;">
                                            <input type="hidden" name="user_id" value="<%= selectedPlayer.id %>">
                                            <input type="hidden" name="inventory_id" value="<%= inv.inventory_id %>">
                                            <input type="number" name="quantity" value="1" min="1" max="<%= inv.quantity %>" style="width:60px; padding:0.25rem;">
                                            <button type="submit" class="btn btn-danger btn-sm" <%= inv.quantity === 0 ? 'disabled' : '' %>>
                                                <i class="fas fa-trash"></i> Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<style>
.player-select-wrapper {
    margin-bottom: 0.75rem;
}
.player-search {
    width: 100%;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
    border: 2px solid var(--khaki);
    border-radius: 6px;
    background: rgba(0,0,0,0.3);
    color: var(--sand);
    font-size: 0.9rem;
    box-sizing: border-box;
}
.player-search:focus {
    outline: none;
    border-color: var(--accent);
}
.player-select-wrapper select {
    width: 100%;
    background: rgba(0,0,0,0.3);
    color: var(--sand);
    border: 2px solid var(--khaki);
    border-radius: 6px;
    padding: 0.25rem;
    box-sizing: border-box;
}
.player-select-wrapper select option {
    background: #1a1a2e;
    color: var(--sand);
}
.inline-form {
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
    flex-wrap: wrap;
}
.inline-form .form-group {
    flex: 1;
    min-width: 200px;
}
.inline-form .form-group label {
    display: block;
    font-size: 0.8rem;
    color: var(--khaki);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.inline-form .form-group select,
.inline-form .form-group input {
    width: 100%;
    padding: 0.5rem;
    border: 2px solid var(--khaki);
    border-radius: 6px;
    background: rgba(0,0,0,0.3);
    color: var(--sand);
    font-size: 0.9rem;
    box-sizing: border-box;
}
.inline-form .form-group select:focus,
.inline-form .form-group input:focus {
    outline: none;
    border-color: var(--accent);
}
.btn-sm {
    padding: 0.35rem 0.6rem;
    font-size: 0.8rem;
}
.empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--khaki);
    font-style: italic;
}
</style>

<script>
function filterPlayers(input) {
    const val = input.value.toLowerCase();
    const select = input.closest('.player-select-wrapper').querySelector('select');
    Array.from(select.options).forEach(opt => {
        if (!opt.value) return;
        const name = opt.getAttribute('data-name') || '';
        opt.style.display = name.includes(val) ? '' : 'none';
    });
}
</script>

<%- include('../../partials/footer') %>