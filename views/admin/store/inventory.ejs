<%- include('../../partials/header') %>

<div class="container">
    <header>
        <h1>🎒 Inventory Management</h1>
        <div class="subtitle">View and manage player inventories</div>
    </header>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <!-- Player Selector -->
    <div class="section">
        <div class="top-row">
            <h2>Select Player</h2>
        </div>
        <form method="GET" action="/admin/store/inventory" class="form-wrap">
            <div class="field">
                <label>Player</label>
                <input type="text" class="player-search" placeholder="Search player..." oninput="filterPlayers(this)">
                <select name="user_id" required size="5">
                    <option value="" disabled <%= !selectedPlayer ? 'selected' : '' %>>— Select Player —</option>
                    <% players.forEach(p => { %>
                        <option value="<%= p.id %>" <%= selectedPlayer && selectedPlayer.id === p.id ? 'selected' : '' %>
                            data-name="<%= (p.discord_global_name || p.discord_username).toLowerCase() %>">
                            <%= p.discord_global_name || p.discord_username %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">🔍 View Inventory</button>
            </div>
        </form>
    </div>

    <% if (selectedPlayer) { %>
        <!-- Grant Item -->
        <div class="section">
            <div class="top-row">
                <h2>🎁 Grant Item to <%= selectedPlayer.discord_global_name || selectedPlayer.discord_username %></h2>
            </div>
            <form method="POST" action="/admin/store/inventory/grant" class="form-wrap">
                <input type="hidden" name="user_id" value="<%= selectedPlayer.id %>">
                <div class="field">
                    <label>Item</label>
                    <select name="item_id" required>
                        <option value="" disabled selected>— Select Item —</option>
                        <% items.forEach(item => { %>
                            <option value="<%= item.id %>"><%= item.display_name %> (<%= item.class_name %>) — <%= item.category_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="field">
                    <label>Quantity</label>
                    <input type="number" name="quantity" value="1" min="1" required>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn">➕ Grant</button>
                </div>
            </form>
        </div>

        <!-- Current Inventory -->
        <div class="section">
            <div class="top-row">
                <h2>🎒 <%= selectedPlayer.discord_global_name || selectedPlayer.discord_username %>'s Inventory</h2>
            </div>
            <% if (playerInventory.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">📦</div>
                    <p>This player has no items in their inventory.</p>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Class Name</th>
                                <th>Type</th>
                                <th>Category</th>
                                <th>Quantity</th>
                                <th>Source</th>
                                <th>Acquired</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% playerInventory.forEach(inv => { %>
                                <tr>
                                    <td><strong><%= inv.display_name %></strong></td>
                                    <td><code><%= inv.class_name %></code></td>
                                    <td><span class="type-badge type-<%= inv.item_type %>"><%= inv.item_type %></span></td>
                                    <td><%= inv.category_name %></td>
                                    <td><strong><%= inv.quantity %></strong></td>
                                    <td><span class="badge badge-<%= inv.source %>"><%= inv.source %></span></td>
                                    <td><%= new Date(inv.acquired_at).toLocaleDateString() %></td>
                                    <td>
                                        <form method="POST" action="/admin/store/inventory/remove" style="display:flex; gap:0.25rem; align-items:center;">
                                            <input type="hidden" name="user_id" value="<%= selectedPlayer.id %>">
                                            <input type="hidden" name="inventory_id" value="<%= inv.inventory_id %>">
                                            <input type="number" name="quantity" value="1" min="1" max="<%= inv.quantity %>" style="width:60px; padding:0.25rem; background:rgba(0,0,0,0.4); border:1px solid rgba(107,142,35,0.5); border-radius:4px; color:var(--sand);">
                                            <button type="submit" class="act act-del" <%= inv.quantity === 0 ? 'disabled' : '' %>>
                                                🗑️ Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<script>
function filterPlayers(input) {
    const val = input.value.toLowerCase();
    const select = input.closest('.field').querySelector('select');
    Array.from(select.options).forEach(opt => {
        if (!opt.value) return;
        const name = opt.getAttribute('data-name') || '';
        opt.style.display = name.includes(val) ? '' : 'none';
    });
}
</script>

<%- include('../../partials/footer') %>