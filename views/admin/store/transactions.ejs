<%- include('../../partials/header') %>

<div class="container">
    <header>
        <h1><i class="fas fa-receipt"></i> Store Transactions</h1>
        <div class="subtitle">Purchase and grant history</div>
    </header>

    <div class="section">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Player</th>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Type</th>
                        <th>Operation</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (transactions.length === 0) { %>
                        <tr><td colspan="9" class="empty-state">No transactions found</td></tr>
                    <% } %>
                    <% transactions.forEach(tx => { %>
                        <tr>
                            <td><%= tx.id %></td>
                            <td><%= new Date(tx.created_at).toLocaleString() %></td>
                            <td><%= tx.discord_username %></td>
                            <td><%= tx.display_name %></td>
                            <td><%= tx.quantity %></td>
                            <td><%= tx.unit_price.toLocaleString() %>¢</td>
                            <td><strong><%= tx.total_price.toLocaleString() %>¢</strong></td>
                            <td><span class="badge badge-<%= tx.transaction_type %>"><%= tx.transaction_type %></span></td>
                            <td><%= tx.operation_id || '-' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <% if (totalPages > 1) { %>
            <div class="pagination">
                <% for (let p = 1; p <= totalPages; p++) { %>
                    <a href="/admin/store/transactions?page=<%= p %>" class="page-link <%= p === page ? 'active' : '' %>"><%= p %></a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<style>
.badge-purchase { background: #2e7d32; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
.badge-grant { background: #1565c0; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
.badge-refund { background: #6a1b9a; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
.badge-admin { background: #c62828; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
.pagination { display: flex; gap: 0.5rem; justify-content: center; margin-top: 1.5rem; }
.page-link { padding: 0.4rem 0.75rem; background: rgba(0,0,0,0.4); border: 1px solid rgba(107,142,35,0.5); border-radius: 4px; color: var(--khaki); text-decoration: none; }
.page-link.active { background: var(--accent); border-color: var(--accent); color: var(--camo-dark); }
</style>

<%- include('../../partials/footer') %>
