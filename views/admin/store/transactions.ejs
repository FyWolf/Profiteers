<%- include('../../partials/header') %>

<div class="container">
    <header>
        <h1>🧾 Store Transactions</h1>
        <div class="subtitle">Purchase and grant history</div>
    </header>

    <div class="section">
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Player</th>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Type</th>
                        <th>Operation</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (transactions.length === 0) { %>
                        <tr><td colspan="9" class="empty-state">No transactions found</td></tr>
                    <% } %>
                    <% transactions.forEach(tx => { %>
                        <tr>
                            <td><%= tx.id %></td>
                            <td><%= new Date(tx.created_at).toLocaleString() %></td>
                            <td><%= tx.discord_username %></td>
                            <td><%= tx.display_name %></td>
                            <td><%= tx.quantity %></td>
                            <td><%= tx.unit_price.toLocaleString() %>¢</td>
                            <td><strong><%= tx.total_price.toLocaleString() %>¢</strong></td>
                            <td><span class="badge badge-<%= tx.transaction_type %>"><%= tx.transaction_type %></span></td>
                            <td><%= tx.operation_id || '-' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <% if (totalPages > 1) { %>
            <div class="pagination">
                <% for (let p = 1; p <= totalPages; p++) { %>
                    <a href="/admin/store/transactions?page=<%= p %>" class="page-btn <%= p === page ? 'current' : '' %>"><%= p %></a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<%- include('../../partials/footer') %>
