<%- include('../../partials/header') %>

<div class="container">
    <header>
        <h1>📤 Bulk Import Items</h1>
        <div class="subtitle">Import Arma 3 class names in bulk</div>
    </header>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="section">
        <div class="top-row">
            <h2>Paste Class Names</h2>
        </div>
        <p style="color: var(--khaki); font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
            Paste Arma 3 class names, one per line. Lines starting with <code>//</code> or <code>#</code> are ignored.
            Display names will be auto-generated from class names (e.g. <code>arifle_MX_F</code> → <code>Arifle Mx F</code>).
            You can edit them afterward.
        </p>

        <form method="POST" class="form-wrap" style="max-width: 800px;">
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label for="category_id">Category</label>
                    <select name="category_id" id="category_id" required>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label for="item_type">Item Type</label>
                    <select name="item_type" id="item_type">
                        <option value="weapon">Weapon</option>
                        <option value="magazine">Magazine</option>
                        <option value="attachment">Attachment</option>
                        <option value="uniform">Uniform</option>
                        <option value="vest">Vest</option>
                        <option value="helmet">Helmet</option>
                        <option value="backpack">Backpack</option>
                        <option value="item">Item</option>
                        <option value="grenade">Grenade</option>
                        <option value="explosive">Explosive</option>
                        <option value="misc">Misc</option>
                    </select>
                </div>
                <div class="field" style="flex: 1; min-width: 150px;">
                    <label for="base_price">Default Price (¢)</label>
                    <input type="number" name="base_price" id="base_price" value="0" min="0">
                </div>
            </div>

            <div class="field">
                <label for="class_names">Class Names (one per line)</label>
                <textarea name="class_names" id="class_names" rows="20" placeholder="arifle_MX_F&#10;arifle_MXC_F&#10;arifle_MX_GL_F&#10;arifle_MX_SW_F&#10;// This is a comment, will be ignored&#10;# This too" style="font-family: 'Consolas', 'Courier New', monospace; font-size: 0.85rem;" required></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn">
                    📤 Import Items
                </button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('class_names').value = ''">
                    🧹 Clear
                </button>
            </div>
        </form>
    </div>

    <div class="section">
        <div class="top-row">
            <h2>Tips</h2>
        </div>
        <ul style="color: var(--khaki); line-height: 1.8; padding-left: 1.5rem;">
            <li>Get class names from the <strong>Arma 3 Config Browser</strong> (in-game with <code>-showScriptErrors</code>)</li>
            <li>Or use tools like <strong>Arma Config Viewer</strong> or <strong>ArmA 3 Class Name Finder</strong> online</li>
            <li>For mod items, check the mod's documentation or use <code>configFile</code> in the game's debug console</li>
            <li>You can also use the <strong>in-game export tool</strong>: fill an arsenal box, then use ACE Interaction → <em>Export to Store Database</em> (admin only)</li>
            <li>Duplicate class names are automatically skipped</li>
        </ul>
    </div>
</div>

<%- include('../../partials/footer') %>
