<%- include('../../partials/header') %>

<div class="container">
    <header>
        <h1><i class="fas fa-store"></i> Store Management</h1>
        <div class="subtitle">Economy &amp; Inventory Administration</div>
    </header>

    <div class="stat-bar">
        <div class="stat-chip">
            <span class="stat-val"><%= stats.total_items %></span>
            <span class="stat-lbl">Total Items</span>
        </div>
        <div class="stat-chip">
            <span class="stat-val"><%= stats.active_items %></span>
            <span class="stat-lbl">Active Items</span>
        </div>
        <div class="stat-chip">
            <span class="stat-val"><%= categories.length %></span>
            <span class="stat-lbl">Categories</span>
        </div>
    </div>

    <div class="section">
        <div class="top-row">
            <h2>Quick Actions</h2>
        </div>
        <div class="form-actions">
            <a href="/admin/store/categories" class="btn">
                <i class="fas fa-folder"></i> Categories
            </a>
            <a href="/admin/store/items" class="btn">
                <i class="fas fa-box"></i> Items
            </a>
            <a href="/admin/store/inventory" class="btn">
                <i class="fas fa-warehouse"></i> Player Inventory
            </a>
            <a href="/admin/store/currency" class="btn">
                <i class="fas fa-coins"></i> Currency
            </a>
            <a href="/admin/store/transactions" class="btn">
                <i class="fas fa-receipt"></i> Transaction Log
            </a>
        </div>
    </div>

    <div class="section">
        <div class="top-row">
            <h2>Recent Transactions</h2>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Player</th>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>Type</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentTransactions.length === 0) { %>
                        <tr><td colspan="6" class="empty-state">No transactions yet</td></tr>
                    <% } %>
                    <% recentTransactions.forEach(tx => { %>
                        <tr>
                            <td><%= new Date(tx.created_at).toLocaleDateString() %></td>
                            <td><%= tx.discord_username %></td>
                            <td><%= tx.display_name %></td>
                            <td><%= tx.quantity %></td>
                            <td><%= tx.total_price.toLocaleString() %>¢</td>
                            <td><span class="badge badge-<%= tx.transaction_type %>"><%= tx.transaction_type %></span></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
.badge-purchase { background: #2e7d32; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
.badge-grant { background: #1565c0; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
.badge-refund { background: #6a1b9a; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
.badge-admin { background: #c62828; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
</style>

<%- include('../../partials/footer') %>
