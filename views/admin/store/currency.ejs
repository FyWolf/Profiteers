<%- include('../../partials/header') %>

<div class="container">
    <header>
        <h1><i class="fas fa-coins"></i> Currency Management</h1>
        <div class="subtitle">Grant or remove player currency</div>
    </header>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="section">
        <div class="top-row">
            <h2>Grant Currency</h2>
        </div>
        <form method="POST" action="/admin/store/currency/grant" class="form-wrap">
            <div class="field">
                <label>Player</label>
                <input type="text" class="player-search" placeholder="Search player..." oninput="filterPlayers(this)">
                <select name="user_id" required size="5">
                    <option value="" disabled selected>— Select Player —</option>
                    <% players.forEach(p => { %>
                        <option value="<%= p.id %>" data-name="<%= (p.discord_global_name || p.discord_username).toLowerCase() %>"><%= p.discord_global_name || p.discord_username %> — <%= p.balance %>¢</option>
                    <% }) %>
                </select>
            </div>
            <div class="field">
                <label>Amount</label>
                <input type="number" name="amount" placeholder="Amount" min="1" required>
            </div>
            <div class="field">
                <label>Reason</label>
                <input type="text" name="reason" placeholder="Reason (optional)">
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Grant Currency</button>
            </div>
        </form>
    </div>

    <div class="section">
        <div class="top-row">
            <h2>Remove Currency</h2>
        </div>
        <form method="POST" action="/admin/store/currency/remove" class="form-wrap">
            <div class="field">
                <label>Player</label>
                <input type="text" class="player-search" placeholder="Search player..." oninput="filterPlayers(this)">
                <select name="user_id" required size="5">
                    <option value="" disabled selected>— Select Player —</option>
                    <% players.forEach(p => { %>
                        <option value="<%= p.id %>" data-name="<%= (p.discord_global_name || p.discord_username).toLowerCase() %>"><%= p.discord_global_name || p.discord_username %> — <%= p.balance %>¢</option>
                    <% }) %>
                </select>
            </div>
            <div class="field">
                <label>Amount</label>
                <input type="number" name="amount" placeholder="Amount" min="1" required>
            </div>
            <div class="field">
                <label>Reason</label>
                <input type="text" name="reason" placeholder="Reason (optional)">
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Remove Currency</button>
            </div>
        </form>
    </div>

    <div class="section">
        <div class="top-row">
            <h2>Player Balances</h2>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Player</th>
                        <th>Balance</th>
                        <th>Lifetime Earned</th>
                        <th>Lifetime Spent</th>
                    </tr>
                </thead>
                <tbody>
                    <% balances.forEach(b => { %>
                        <tr>
                            <td><%= b.user_id %></td>
                            <td><%= b.discord_global_name || b.discord_username %></td>
                            <td><strong><%= b.balance.toLocaleString() %>¢</strong></td>
                            <td><%= b.lifetime_earned.toLocaleString() %>¢</td>
                            <td><%= b.lifetime_spent.toLocaleString() %>¢</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
.player-search {
    width: 100%;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
    border: 2px solid var(--khaki);
    border-radius: 6px;
    background: rgba(0,0,0,0.3);
    color: var(--sand);
    font-size: 0.9rem;
    box-sizing: border-box;
}
.player-search:focus {
    outline: none;
    border-color: var(--accent);
}
.field select {
    min-width: 250px;
}
</style>

<script>
function filterPlayers(input) {
    const q = input.value.toLowerCase();
    const select = input.closest('.field').querySelector('select');
    for (const opt of select.options) {
        if (!opt.value) continue; // skip placeholder
        opt.style.display = opt.dataset.name.includes(q) ? '' : 'none';
    }
}
</script>

<%- include('../../partials/footer') %>
