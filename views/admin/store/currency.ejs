<%- include('../../partials/header') %>

<div class="container">
    <h1><i class="fas fa-coins"></i> Currency Management</h1>
    <a href="/admin/store" class="back-link">&larr; Back to Store Admin</a>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="admin-card">
        <h2>Grant Currency</h2>
        <form method="POST" action="/admin/store/currency/grant" class="inline-form">
            <div class="player-select-wrapper">
                <input type="text" class="player-search" placeholder="Search player..." oninput="filterPlayers(this)">
                <select name="user_id" required size="5">
                    <option value="" disabled selected>— Select Player —</option>
                    <% players.forEach(p => { %>
                        <option value="<%= p.id %>" data-name="<%= (p.discord_global_name || p.discord_username).toLowerCase() %>"><%= p.discord_global_name || p.discord_username %> — <%= p.balance %>¢</option>
                    <% }) %>
                </select>
            </div>
            <input type="number" name="amount" placeholder="Amount" min="1" required>
            <input type="text" name="reason" placeholder="Reason (optional)">
            <button type="submit" class="btn btn-success">Grant</button>
        </form>
    </div>

    <div class="admin-card">
        <h2>Remove Currency</h2>
        <form method="POST" action="/admin/store/currency/remove" class="inline-form">
            <div class="player-select-wrapper">
                <input type="text" class="player-search" placeholder="Search player..." oninput="filterPlayers(this)">
                <select name="user_id" required size="5">
                    <option value="" disabled selected>— Select Player —</option>
                    <% players.forEach(p => { %>
                        <option value="<%= p.id %>" data-name="<%= (p.discord_global_name || p.discord_username).toLowerCase() %>"><%= p.discord_global_name || p.discord_username %> — <%= p.balance %>¢</option>
                    <% }) %>
                </select>
            </div>
            <input type="number" name="amount" placeholder="Amount" min="1" required>
            <input type="text" name="reason" placeholder="Reason (optional)">
            <button type="submit" class="btn btn-danger">Remove</button>
        </form>
    </div>

    <h2>Player Balances</h2>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Player</th>
                    <th>Balance</th>
                    <th>Lifetime Earned</th>
                    <th>Lifetime Spent</th>
                </tr>
            </thead>
            <tbody>
                <% balances.forEach(b => { %>
                    <tr>
                        <td><%= b.user_id %></td>
                        <td><%= b.discord_global_name || b.discord_username %></td>
                        <td><strong><%= b.balance.toLocaleString() %>¢</strong></td>
                        <td><%= b.lifetime_earned.toLocaleString() %>¢</td>
                        <td><%= b.lifetime_spent.toLocaleString() %>¢</td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<style>
.admin-card {
    background: var(--card-bg, #1e1e2e);
    border: 1px solid var(--border-color, #333);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
}
.inline-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: flex-end;
}
.inline-form input,
.inline-form select {
    padding: 0.5rem;
    background: #2a2a3a;
    border: 1px solid #444;
    border-radius: 4px;
    color: #e0e0e0;
}
.inline-form select {
    min-width: 250px;
    cursor: pointer;
}
.player-select-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}
.player-search {
    padding: 0.5rem;
    background: #2a2a3a;
    border: 1px solid #444;
    border-radius: 4px;
    color: #e0e0e0;
    min-width: 250px;
}
.player-search:focus {
    border-color: #ffd700;
    outline: none;
}
.player-select-wrapper select {
    min-width: 250px;
}
</style>

<script>
function filterPlayers(input) {
    const q = input.value.toLowerCase();
    const select = input.closest('.player-select-wrapper').querySelector('select');
    for (const opt of select.options) {
        if (!opt.value) continue; // skip placeholder
        opt.style.display = opt.dataset.name.includes(q) ? '' : 'none';
    }
}
</script>

<%- include('../../partials/footer') %>
