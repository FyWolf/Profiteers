<%- include('../partials/header') %>

<div class="container">
    <header>
        <a href="/store" class="back-link">← Back to Store</a>
        <h1><%= category.icon || '🎖️' %> <%= category.name %></h1>
        <div class="subtitle">Browse and purchase gear</div>
    </header>

    <div style="display: flex; justify-content: flex-end; margin-bottom: 2rem;">
        <div class="card" style="display: flex; align-items: center; gap: 1rem; padding: 1rem 1.5rem; min-width: 200px;">
            <div style="font-size: 2rem; color: var(--accent);">💰</div>
            <div style="display: flex; flex-direction: column;">
                <span style="font-size: 0.8rem; color: var(--olive-light); text-transform: uppercase; letter-spacing: 1px;">Your Balance</span>
                <span style="font-size: 1.5rem; font-weight: 700; color: var(--accent);" id="walletBalance"><%= balance.toLocaleString() %> <small style="font-size: 0.9rem; opacity: 0.7;">¢</small></span>
            </div>
        </div>
    </div>

    <div style="display:flex; gap:0.75rem; margin-bottom:1.5rem; flex-wrap:wrap;">
        <input type="text" id="storeSearch" placeholder="Search items..." style="flex:1; min-width:200px; padding:0.6rem 1rem; background:rgba(0,0,0,0.4); border:2px solid var(--khaki); border-radius:8px; color:var(--sand); font-size:0.9rem;">
        <select id="storeTypeFilter" style="padding:0.6rem 1rem; background:rgba(0,0,0,0.4); border:2px solid var(--khaki); border-radius:8px; color:var(--sand); font-size:0.9rem;">
            <option value="">All Types</option>
            <option value="weapon">Weapons</option>
            <option value="magazine">Magazines</option>
            <option value="attachment">Attachments</option>
            <option value="uniform">Uniforms</option>
            <option value="vest">Vests</option>
            <option value="helmet">Helmets</option>
            <option value="backpack">Backpacks</option>
            <option value="item">Items</option>
            <option value="grenade">Grenades</option>
            <option value="explosive">Explosives</option>
            <option value="misc">Misc</option>
        </select>
    </div>

    <div class="items-grid" id="storeItemsGrid">
        <% if (items.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <p>No items available in this category yet.</p>
            </div>
        <% } %>

        <% items.forEach(item => { %>
            <div class="store-item-card" data-item-id="<%= item.id %>" data-price="<%= item.base_price %>" data-type="<%= item.item_type %>">
                <div class="item-image">
                    <% if (item.image_url) { %>
                        <img src="<%= item.image_url %>" alt="<%= item.display_name %>">
                    <% } else { %>
                        <div class="item-placeholder">
                            <%= item.item_type === 'weapon' ? '🔫' : item.item_type === 'uniform' ? '👕' : item.item_type === 'vest' ? '🦺' : item.item_type === 'helmet' ? '⛑️' : item.item_type === 'backpack' ? '🎒' : item.item_type === 'attachment' ? '🔭' : item.item_type === 'grenade' ? '💣' : item.item_type === 'explosive' ? '🧨' : '📦' %>
                        </div>
                    <% } %>
                </div>
                <div class="item-details">
                    <h3 class="item-name"><%= item.display_name %></h3>
                    <span class="item-class"><%= item.class_name %></span>
                    <div class="item-meta">
                        <span class="item-type-badge type-<%= item.item_type %>"><%= item.item_type %></span>
                        <% if (item.owned_qty > 0) { %>
                            <span class="owned-badge">✅ Owned: <%= item.owned_qty %></span>
                        <% } %>
                    </div>
                    <% if (item.description) { %>
                        <p class="item-description"><%= item.description %></p>
                    <% } %>
                </div>
                <div class="item-actions">
                    <div class="item-price">
                        <span class="price-value"><%= item.base_price.toLocaleString() %></span>
                        <span class="price-currency">¢</span>
                    </div>
                    <% if (item.stock !== -1) { %>
                        <div class="stock-info">
                            Stock: <%= item.stock %>
                        </div>
                    <% } %>
                    <div class="buy-controls">
                        <div class="qty-selector">
                            <button class="qty-btn qty-minus" disabled>−</button>
                            <input type="number" class="qty-input" value="1" min="1" max="99" readonly>
                            <button class="qty-btn qty-plus">+</button>
                        </div>
                        <button class="btn buy-btn" <%= balance < item.base_price ? 'disabled' : '' %>>
                            🛒 Buy
                        </button>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- Toast notification -->
<div id="toast" class="toast"></div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Search & filter
    const storeSearch = document.getElementById('storeSearch');
    const storeTypeFilter = document.getElementById('storeTypeFilter');
    if (storeSearch && storeTypeFilter) {
        function filterStoreItems() {
            const q = storeSearch.value.toLowerCase();
            const type = storeTypeFilter.value;
            document.querySelectorAll('#storeItemsGrid .store-item-card').forEach(card => {
                const text = card.textContent.toLowerCase();
                const cardType = card.dataset.type || '';
                const matchSearch = !q || text.includes(q);
                const matchType = !type || cardType === type;
                card.style.display = matchSearch && matchType ? '' : 'none';
            });
        }
        storeSearch.addEventListener('input', filterStoreItems);
        storeTypeFilter.addEventListener('change', filterStoreItems);
    }

    function showToast(message, type = 'success') {
        const el = document.getElementById('toast');
        el.textContent = message;
        el.className = `toast ${type} show`;
        setTimeout(() => el.classList.remove('show'), 3000);
    }

    // Quantity controls
    document.querySelectorAll('.qty-plus').forEach(btn => {
        btn.addEventListener('click', () => {
            const input = btn.closest('.qty-selector').querySelector('.qty-input');
            const minus = btn.closest('.qty-selector').querySelector('.qty-minus');
            const val = parseInt(input.value) + 1;
            if (val <= 99) {
                input.value = val;
                minus.disabled = false;
            }
        });
    });

    document.querySelectorAll('.qty-minus').forEach(btn => {
        btn.addEventListener('click', () => {
            const input = btn.closest('.qty-selector').querySelector('.qty-input');
            const val = parseInt(input.value) - 1;
            if (val >= 1) {
                input.value = val;
                if (val === 1) btn.disabled = true;
            }
        });
    });

    // Buy buttons
    document.querySelectorAll('.buy-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const card = btn.closest('.store-item-card');
            const itemId = card.dataset.itemId;
            const qty = parseInt(card.querySelector('.qty-input').value);
            const price = parseInt(card.dataset.price) * qty;

            btn.disabled = true;
            btn.innerHTML = '⏳ Buying...';

            try {
                const res = await fetch('/store/api/buy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ itemId, quantity: qty })
                });
                const data = await res.json();

                if (data.success) {
                    document.getElementById('walletBalance').innerHTML = data.balance.toLocaleString() + ' <small>¢</small>';
                    showToast(`Purchased ${qty}x ${card.querySelector('.item-name').textContent}!`);
                    // Update or create owned badge
                    let badge = card.querySelector('.owned-badge');
                    const meta = card.querySelector('.item-meta');
                    if (badge) {
                        const match = badge.textContent.match(/\d+/);
                        if (match) badge.innerHTML = `✅ Owned: ${parseInt(match[0]) + qty}`;
                    } else if (meta) {
                        const newBadge = document.createElement('span');
                        newBadge.className = 'owned-badge';
                        newBadge.innerHTML = `✅ Owned: ${qty}`;
                        meta.appendChild(newBadge);
                    }
                } else {
                    showToast(data.error || 'Purchase failed', 'error');
                }
            } catch (err) {
                showToast('Network error', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '🛒 Buy';
            }
        });
    });
});
</script>

<%- include('../partials/footer') %>
