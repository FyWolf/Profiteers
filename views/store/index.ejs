<%- include('../partials/header') %>

<div class="container">
    <header>
        <h1>🏪 Equipment Store</h1>
        <div class="subtitle">Browse and purchase gear for upcoming operations</div>
    </header>

    <div style="display: flex; justify-content: flex-end; margin-bottom: 2rem;">
        <div class="card" style="display: flex; align-items: center; gap: 1rem; padding: 1rem 1.5rem; min-width: 200px;">
            <div style="font-size: 2rem; color: var(--accent);">💰</div>
            <div style="display: flex; flex-direction: column;">
                <span style="font-size: 0.8rem; color: var(--olive-light); text-transform: uppercase; letter-spacing: 1px;">Your Balance</span>
                <span style="font-size: 1.5rem; font-weight: 700; color: var(--accent);" id="walletBalance"><%= balance.toLocaleString() %> <small style="font-size: 0.9rem; opacity: 0.7;">¢</small></span>
            </div>
        </div>
    </div>

    <div class="store-categories">
        <% categories.forEach(cat => { %>
            <a href="/store/category/<%= cat.slug %>" class="category-card">
                <div class="category-icon">
                    <%= cat.icon || '🎖️' %>
                </div>
                <div class="category-info">
                    <h3 style="margin: 0 0 0.25rem 0;"><%= cat.name %></h3>
                    <span class="item-count"><%= cat.item_count %> items</span>
                </div>
                <div class="category-arrow">›</div>
            </a>
        <% }) %>
    </div>
</div>

<%- include('../partials/footer') %>
